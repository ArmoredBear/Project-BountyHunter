[internationalization]

locale/translations=PackedStringArray("res://Common/Resources/Localization/translations.en.translation")
locale/fallback="pt"
rendering/text_driver="ICU / HarfBuzz / Graphite (Built-in)"

[layer_names]

2d_physics/layer_1="Player"
2d_navigation/layer_1="Enemies"
2d_physics/layer_2="Enemies"
2d_navigation/layer_2="Bosses"
2d_physics/layer_3="Bosses"
2d_physics/layer_4="Ground"
2d_physics/layer_5="Walls"
2d_physics/layer_6="NavChunks"

[navigation]

2d/merge_rasterizer_cell_scale=4

[rendering]

occlusion_culling/jitter_projection=false
textures/canvas_textures/default_texture_filter=0
textures/lossless_compression/force_png=true
2d/shadow_atlas/size=4096
textures/default_filters/use_nearest_mipmap_filter=true
textures/default_filters/anisotropic_filtering_level=4
camera/depth_of_field/depth_of_field_bokeh_shape=0
environment/ssao/quality=3
environment/ssil/quality=3
viewport/hdr_2d=true
textures/decals/filter=0
textures/light_projectors/filter=0
environment/subsurface_scattering/subsurface_scattering_quality=3
2d/sdf/scale=0
environment/screen_space_reflection/roughness_quality=3
viewport/size/initial_position_type=1
