; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project Bounty Hunter"
run/main_scene="res://Common/MainScenes/Main_Menu.tscn"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")
run/max_fps=60
boot_splash/bg_color=Color(0, 0, 0, 1)
config/icon="res://icon.svg"
boot_splash/minimum_display_time=5000

[audio]

buses/default_bus_layout="uid://cgm37sncx5b87"

[autoload]

Player_Data_Autoload="*res://Common/Resources/Player/PlayerScripts/Player_Data_Autoload.cs"
Player="*res://Common/Resources/Player/PlayerPrefabs/Player.tscn"
Messenger="*res://Common/Resources/General Scritps/Messenger.cs"
Game_Manager="*res://Common/Resources/General Scritps/GameManager.cs"
Scene_Manager="*res://Common/MainScenes/Scene_Manager.tscn"
SaveLoadControl="*res://Common/Resources/General Scritps/Save_Load_Control.cs"
AudioManager="*res://Common/Resources/General Scritps/Audio/AudioManager.cs"
Settings="*res://Common/Resources/General Scritps/Options/Settings.cs"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1080
window/size/borderless=true
window/size/extend_to_title=true
window/stretch/mode="viewport"
window/per_pixel_transparency/allowed=true

[dotnet]

project/assembly_name="Project Bounty Hunter"

[editor_plugins]

enabled=PackedStringArray("res://addons/csharp_inspector_tooltips/plugin.cfg")

[global_group]

player="Player Group"
enemy=""
player_attack=""
boss=""
enemy_attack=""

