code = "shader_type canvas_item;
render_mode blend_mix;

uniform bool Enabled = false;
uniform vec4 FlashTint : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);



void fragment() {
// BooleanParameter:2
	bool n_out2p0 = Enabled;


// ColorParameter:4
	vec4 n_out4p0 = FlashTint;


// Input:6
	vec4 n_out6p0 = COLOR;


	vec3 n_out5p0;
// If:5
	float n_in5p1 = 1.00000;
	float n_in5p2 = 0.00001;
	if(abs((n_out2p0 ? 1.0 : 0.0) - n_in5p1) < n_in5p2)
	{
		n_out5p0 = vec3(n_out4p0.xyz);
	}
	else if((n_out2p0 ? 1.0 : 0.0) < n_in5p1)
	{
		n_out5p0 = vec3(n_out6p0.xyz);
	}
	else
	{
		n_out5p0 = vec3(n_out6p0.xyz);
	}


// Output:0
	COLOR.rgb = n_out5p0;


}
"
